NODE_ENV=development
API_PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Preencha a senha somente no .env local, ignorado pelo Git.
DB_PASSWORD=
DB_NAME=study_platform_dev
TEST_DB_NAME=study_platform_test
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_ORIGIN=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: chave hexadecimal independente de 32 bytes para os tokens Classroom.
# Sem esta chave a integração permanece indisponível, sem bloquear a conta.
CLASSROOM_ENCRYPTION_KEY=
# SMTP local (Mailpit nativo): veja o README; caixa em http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost.test
# Gere duas chaves diferentes: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
EMAIL_HMAC_KEY=
EMAIL_ENCRYPTION_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
# Chave de assinatura de prévias; independente do par Gemini.
AI_RECEIPT_KEY=
# Obrigatórias: chave dedicada de 32 bytes hex e versão; nunca reutilize chaves de e-mail/recibos.
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_CREDENTIAL_KEY_VERSION=v1
AI_USER_REQUESTS_PER_MINUTE=5
AI_USER_MAX_CONCURRENCY=1
AI_DEFAULT_USER_DAILY_LIMIT=20
AI_DEFAULT_GLOBAL_DAILY_LIMIT=500
AI_DEFAULT_GLOBAL_MAX_CONCURRENCY=5
AI_TIMEOUT_MS=30000
AI_MAX_RESPONSE_BYTES=524288
VITE_API_BASE_URL=http://localhost:3001
# Origens LAN exatas, separadas por vírgulas; somente desenvolvimento (ex.: http://192.168.15.12:5173)
DEV_WEB_ORIGINS=
