{
  "name": "@study-platform/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migration:show": "tsx src/database/show-migrations.ts",
    "migration:run": "tsx src/database/run-migrations.ts"
  },
  "dependencies": {
    "@study-platform/contracts": "workspace:*",
    "cors": "2.8.6",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "mysql2": "3.24.4",
    "openid-client": "^6.8.8",
    "pino": "10.3.1",
    "tldts": "7.4.14",
    "typeorm": "1.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
